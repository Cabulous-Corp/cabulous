{
  "components": {
    "schemas": {
      "User": {
        "properties": {
          "avatar": {
            "format": "binary",
            "nullable": true,
            "readOnly": true,
            "type": "string"
          },
          "avatar_key": {
            "type": "string",
            "writeOnly": true
          },
          "banner": {
            "format": "binary",
            "nullable": true,
            "readOnly": true,
            "type": "string"
          },
          "banner_key": {
            "type": "string",
            "writeOnly": true
          },
          "bio": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "date_joined": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "deleted_at": {
            "format": "date-time",
            "nullable": true,
            "readOnly": true,
            "type": "string"
          },
          "discord_username": {
            "maxLength": 100,
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "first_name": {
            "maxLength": 150,
            "type": "string"
          },
          "groups": {
            "description": "Os grupos que este usu\u00e1rio pertence. Um usu\u00e1rio ter\u00e1 todas as permiss\u00f5es concedidas a cada um dos seus grupos.",
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "readOnly": true,
            "type": "string"
          },
          "invitation_accepted_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "invited_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "is_active": {
            "description": "Indica que o usu\u00e1rio ser\u00e1 tratado como ativo. Ao inv\u00e9s de excluir contas de usu\u00e1rio, desmarque isso.",
            "type": "boolean"
          },
          "is_staff": {
            "description": "Indica que usu\u00e1rio consegue acessar este site de administra\u00e7\u00e3o.",
            "type": "boolean"
          },
          "is_superuser": {
            "description": "Indica que este usu\u00e1rio tem todas as permiss\u00f5es sem atribu\u00ed-las explicitamente.",
            "type": "boolean"
          },
          "last_login": {
            "format": "date-time",
            "nullable": true,
            "readOnly": true,
            "type": "string"
          },
          "last_name": {
            "maxLength": 150,
            "type": "string"
          },
          "onboarding_completed_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "password_defined_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "phone_number": {
            "maxLength": 20,
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "user_permissions": {
            "description": "Permiss\u00f5es espec\u00edficas para este usu\u00e1rio.",
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "username": {
            "maxLength": 150,
            "type": "string"
          }
        },
        "required": [
          "username",
          "email"
        ],
        "type": "object"
      }
    }
  },
